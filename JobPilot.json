    {
      "parameters": {
        "jsCode": "// Mode: Run Once for Each Item\nconst base = $('Parse LinkedIn Email').item.json;\nconst html = $json.data || '';\nconst failed = !html || $json.error;\n\nconst decode = (s) =>\n  s.replace(/&amp;/g, '&')\n   .replace(/&#39;|&apos;/g, \"'\")\n   .replace(/&quot;/g, '\"')\n   .replace(/&lt;/g, '<')\n   .replace(/&gt;/g, '>')\n   .replace(/&nbsp;/g, ' ');\n\nconst htmlToText = (s) =>\n  decode(\n    s.replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n     .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n     .replace(/<br\\s*\\/?>/gi, '\\n')\n     .replace(/<\\/(p|div|li|h[1-6]|ul|ol)>/gi, '\\n')\n     .replace(/<li[^>]*>/gi, '- ')\n     .replace(/<[^>]+>/g, ' ')\n  )\n  .replace(/[ \\t]+/g, ' ')\n  .replace(/\\n\\s*\\n+/g, '\\n')\n  .trim();\n\nlet title = base.anchorText || '';\nlet company = '';\nlet location = '';\nlet description = '';\n\nif (!failed) {\n  // 1) Try JSON-LD structured data\n  const ld = html.match(/<script type=\"application\\/ld\\+json\">([\\s\\S]*?)<\\/script>/i);\n  if (ld) {\n    try {\n      const data = JSON.parse(ld[1]);\n      title = data.title || title;\n      company = data.hiringOrganization?.name || '';\n      location = data.jobLocation?.address?.addressLocality || '';\n      if (data.description) description = htmlToText(data.description);\n    } catch (e) { /* ignore parse errors */ }\n  }\n\n  // 2) Fallback: LinkedIn's description container\n  if (!description) {\n    const block = html.match(\n      /class=\"[^\"]*show-more-less-html__markup[^\"]*\"[^>]*>([\\s\\S]*?)<\\/div>/i\n    );\n    if (block) description = htmlToText(block[1]);\n  }\n\n  // 3) Last resort: whole body text\n  if (!description) {\n    const body = html.match(/<body[\\s\\S]*<\\/body>/i);\n    description = htmlToText(body ? body[0] : html);\n  }\n}\n\n// Keep the prompt size reasonable for the free tier\ndescription = description.slice(0, 6000);\n\nreturn {\n  json: {\n    jobId: base.jobId,\n    url: base.url,\n    title,\n    company,\n    location,\n    description,\n    fetchFailed: failed || description.length < 200,\n    // Used by the JD Analyzer when the page couldn't be fetched\n    fallbackText: base.anchorText,\n  },\n};"
      },
