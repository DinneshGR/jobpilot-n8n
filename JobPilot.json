    {
      "parameters": {
        "jsCode": "// Mode: Run Once for Each Item\nconst job = $('Clean Job Page').item.json;\nconst jd = $('JD Analyzer').item.json.output || {};\nconst analysis = $('Resume Analysis').item.json.output || {};\n\nconst coverLetter =\n  typeof $json.output === 'string' ? $json.output.trim() : '';\n\nconst title = jd.job_title || job.title || '';\nconst company = jd.company || job.company || '';\n\nreturn {\n  json: {\n    jobId: job.jobId,\n    title,\n    company,\n    location: jd.location || job.location || '',\n    url: job.url,\n    matchScore: analysis.match_score ?? '',\n    recommendation: analysis.recommendation || '',\n    matchingSkills: (analysis.matching_skills || []).join(', '),\n    missingSkills: (analysis.missing_skills || []).join(', '),\n    resumeTweaks: (analysis.resume_tweaks || []).join(' | '),\n    coverLetter,\n    hasCoverLetter: coverLetter.length > 0,\n    status: coverLetter ? 'Draft ready' : 'Skipped (low match)',\n    processedAt: new Date().toISOString(),\n    // Used for the Gmail draft\n    emailSubject: `Cover letter: ${title} at ${company}`,\n    emailBody:\n      `Job: ${title} at ${company}\\n` +\n      `Link: ${job.url}\\n` +\n      `Match score: ${analysis.match_score ?? 'n/a'} (${analysis.recommendation || 'n/a'})\\n\\n` +\n      `Resume tweaks:\\n- ${(analysis.resume_tweaks || []).join('\\n- ')}\\n\\n` +\n      `----- Cover letter -----\\n\\n${coverLetter}`,\n  },\n};"
      },
