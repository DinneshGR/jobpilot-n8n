    {
      "parameters": {
        "jsCode": "// Mode: Run Once for Each Item\nconst mail = $('Gmail Trigger').item.json;\nconst html = mail.html || mail.textAsHtml || '';\nconst text = mail.text || '';\nconst subject = mail.subject || '';\nconst messageId = mail.id || '';\nconst decode = (s) =>\n  s.replace(/&amp;/g, '&')\n   .replace(/&#39;|&apos;/g, \"'\")\n   .replace(/&quot;/g, '\"')\n   .replace(/&lt;/g, '<')\n   .replace(/&gt;/g, '>')\n   .replace(/&nbsp;/g, ' ');\n\nconst stripTags = (s) =>\n  decode(s.replace(/<[^>]+>/g, ' ')).replace(/\\s+/g, ' ').trim();\n\nconst jobs = new Map();\n\n// Match every anchor pointing to a LinkedIn job view page\nconst anchorRegex =\n  /<a[^>]+href=\"([^\"]*linkedin\\.com\\/(?:comm\\/)?jobs\\/view\\/[^\"]*)\"[^>]*>([\\s\\S]*?)<\\/a>/gi;\n\nlet m;\nwhile ((m = anchorRegex.exec(html)) !== null) {\n  const href = decode(m[1]);\n  const idMatch = href.match(/jobs\\/view\\/(?:[^\\/?\"\\s]*-)?(\\d{6,})/);\n  if (!idMatch) continue;\n\n  const jobId = idMatch[1];\n  const label = stripTags(m[2]);\n\n  const existing = jobs.get(jobId);\n  // Keep the anchor that has the most useful text (usually the job title)\n  if (!existing || (label.length > existing.anchorText.length)) {\n    jobs.set(jobId, {\n      jobId,\n      anchorText: label,\n      url: `https://www.linkedin.com/jobs/view/${jobId}`,\n    });\n  }\n}\n\n// Fallback: plain-text body if no anchors were found\nif (jobs.size === 0 && text) {\n  const plainRegex = /linkedin\\.com\\/(?:comm\\/)?jobs\\/view\\/(?:[^\\/?\\s]*-)?(\\d{6,})/g;\n  let p;\n  while ((p = plainRegex.exec(text)) !== null) {\n    jobs.set(p[1], {\n      jobId: p[1],\n      anchorText: '',\n      url: `https://www.linkedin.com/jobs/view/${p[1]}`,\n    });\n  }\n}\n\n// Return one item per job (no Split Out node needed)\nconst out = [...jobs.values()].map((j) => ({\n  json: {\n    ...j,\n    emailSubject: subject,\n    emailId: messageId,\n  },\n}));\n\n// If nothing was found, return an empty array so the workflow stops cleanly\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
